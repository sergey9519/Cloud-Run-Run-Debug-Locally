// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Freelancer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  role      String?
  bio       String?
  portfolioUrl String?
  rate      Float?
  currency  String?  @default("USD")
  timezone  String?
  status    FreelancerStatus @default(ACTIVE)

  skills    FreelancersOnSkills[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([role])
}

model Skill {
  id    String @id @default(cuid())
  name  String @unique

  freelancers FreelancersOnSkills[]

  createdAt DateTime @default(now())
}

// Explicit many-to-many join table for Freelancers and Skills
model FreelancersOnSkills {
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  freelancerId String
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId      String

  assignedAt DateTime @default(now())

  @@id([freelancerId, skillId])
}

enum FreelancerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}