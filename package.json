{
  "name": "studio-roster",
  "version": "0.0.1",
  "description": "AI-Native Agency Management System",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:api": "npm run start:dev --workspace=api",
    "build": "npm run build --workspaces",
    "build:api": "npm run build --workspace=api",
    "build:web": "npm run build --workspace=web",
    "start:api": "npm start --workspace=api",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint -- --fix",
    "test": "npm test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present"
  },
  "dependencies": {
    "@google-cloud/language": "^7.2.1",
    "@google-cloud/storage": "^7.17.3",
    "@google-cloud/translate": "^8.3.0",
    "@google/generative-ai": "^0.21.0",
    "@nestjs/bullmq": "^10.1.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/event-emitter": "^2.0.0",
    "@nestjs/mapped-types": "^2.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/serve-static": "^5.0.4",
    "@prisma/client": "^5.0.0",
    "buffer": "^6.0.3",
    "bullmq": "^5.7.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "exceljs": "^4.3.0",
    "google-auth-library": "^9.0.0",
    "googleapis": "^126.0.0",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.260.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "xlsx": "^0.18.5",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.3.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.27",
    "prisma": "^5.0.0",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.1.3",
    "vite": "^7.2.6"
  }
}
